{
  "nodes": [
    { "id": "cjc-1295", "type": "compound", "label": "CJC-1295", "family": "family:gh-secretagogues", "drug_class": "GHRH receptor agonist", "forms": ["DAC (albumin-conjugated)", "no-DAC / Mod GRF (1-29)"], "approval": "not approved; development discontinued 2006", "evidence_tier": 2 },
    { "id": "family:gh-secretagogues", "type": "family", "label": "GH secretagogues and GHRH analogues" },

    { "id": "target:ghrhr", "type": "target", "label": "GHRH receptor (GHRHR)", "tissue": "anterior pituitary somatotroph", "receptor_class": "class B1 GPCR, Gs/cAMP" },
    { "id": "target:ghsr", "type": "target", "label": "Ghrelin receptor GHSR-1a", "note": "not a CJC-1295 target; included for family contrast" },
    { "id": "target:albumin-cys34", "type": "target", "label": "Human serum albumin Cys34 thiol", "note": "covalent DAC conjugation site, not a signalling receptor" },

    { "id": "effect:gh-release", "type": "effect", "label": "Growth hormone release" },
    { "id": "effect:igf1-elevation", "type": "effect", "label": "IGF-1 elevation" },
    { "id": "effect:preserved-gh-pulsatility", "type": "effect", "label": "Preserved GH pulsatility" },
    { "id": "effect:somatotroph-proliferation", "type": "effect", "label": "Pituitary somatotroph proliferation", "species": "mouse" },
    { "id": "effect:growth-normalization", "type": "effect", "label": "Normalization of growth in GHRH deficiency", "species": "mouse" },

    { "id": "risk:water-retention", "type": "risk", "label": "Fluid retention / oedema / arthralgia", "strength": "inferred from GH-axis class, not quantified for CJC-1295" },
    { "id": "risk:insulin-resistance", "type": "risk", "label": "Reduced insulin sensitivity / raised fasting glucose", "strength": "class evidence (MK-677 RCT); not measured for CJC-1295" },
    { "id": "risk:igf1-cancer-theoretical", "type": "risk", "label": "Theoretical neoplasia risk from sustained IGF-1 elevation", "strength": "theoretical; observational IGF-1 epidemiology only" },
    { "id": "risk:trial-death-unestablished-causality", "type": "risk", "label": "Phase 2 halted after participant death (July 2006, Argentina); causality never publicly established", "strength": "event verified; causality not established" },
    { "id": "risk:cardiovascular-ae", "type": "risk", "label": "Increased heart rate / systemic vasodilatory reaction", "strength": "identified by FDA in compounding safety-risk material" },
    { "id": "risk:product-mislabelling", "type": "risk", "label": "DAC vs no-DAC mislabelling (large exposure difference)", "strength": "market/quality risk" },
    { "id": "risk:immunogenicity-impurities", "type": "risk", "label": "Immunogenicity from aggregation or peptide-related impurities", "strength": "FDA class concern for compounded peptides" },

    { "id": "cjc-1295:study:teichman-2006", "type": "study", "year": 2006, "species": "human", "n": "healthy adults, ages 21-61 (two ascending-dose trials)", "design": "randomized double-blind placebo-controlled ascending-dose, 28 d and 49 d", "outcome": "GH up ~2-10x for >=6 d; IGF-1 up ~1.5-3x for 9-11 d; estimated half-life 5.8-8.1 d; no serious adverse reactions reported", "label": "Teichman 2006" },
    { "id": "cjc-1295:study:ionescu-2006", "type": "study", "year": 2006, "species": "human", "n": "healthy men 20-40, small n", "design": "pharmacodynamic GH profiling before and ~1 week after single injection", "outcome": "pulse frequency and amplitude unchanged; trough GH up ~7.5x; mean GH and IGF-1 up; IGF-1 rise did not correlate with any GH secretion parameter", "label": "Ionescu & Frohman 2006" },
    { "id": "cjc-1295:study:nct00267527", "type": "study", "year": 2006, "species": "human", "n": "not reported", "design": "phase 2, HIV-associated visceral obesity", "outcome": "TERMINATED July 2006 after participant death; no results published; programme not resumed", "label": "NCT00267527 (terminated)" },
    { "id": "cjc-1295:study:jette-2005", "type": "study", "year": 2005, "species": "rat / in vitro", "n": "n/a", "design": "DPP-IV stability, GH secretion assay, subcutaneous dosing in Sprague-Dawley rats, serum Western blot", "outcome": "CJC-1295 identified as long-lasting GRF analogue; ~4x GH AUC over 2 h vs hGRF(1-29); plasma-detectable beyond 72 h; bound to albumin band from ~15 min", "label": "Jette 2005" },
    { "id": "cjc-1295:study:alba-2006", "type": "study", "year": 2006, "species": "mouse", "n": "GHRH-knockout mice, 3 dosing-interval groups + placebo + heterozygous controls", "design": "5-week treatment from 1 week of age at 24/48/72 h intervals", "outcome": "daily dosing normalized body weight and length; 48/72 h intervals less effective (partial); increased pituitary total RNA and GH mRNA with IHC consistent with somatotroph proliferation", "label": "Alba 2006" },
    { "id": "cjc-1295:study:nass-2008-mk677", "type": "study", "year": 2008, "species": "human", "n": 65, "design": "2-year double-blind randomized placebo-controlled modified-crossover trial of MK-677 25 mg/d in healthy adults 60-81 (class evidence, not CJC-1295)", "outcome": "fasting glucose +0.3 mmol/L (5 mg/dL, p=0.015), insulin sensitivity decreased; fat-free mass increased", "label": "Nass 2008 (MK-677, class evidence)" },
    { "id": "cjc-1295:study:renehan-2004", "type": "study", "year": 2004, "species": "human", "n": "3609 cases / 7137 controls, 21 studies (26 datasets)", "design": "systematic review and meta-regression of case-control studies of circulating IGF-1 and cancer risk (background epidemiology, no secretagogue exposure)", "outcome": "IGF-1 75th vs 25th percentile: prostate cancer OR 1.49 (1.14-1.95), premenopausal breast cancer OR 1.65 (1.26-2.08); associations modest and variable by site", "label": "Renehan 2004" },

    { "id": "cjc-1295:claim:gh-igf1-rise", "type": "claim", "label": "Raises GH and IGF-1", "verdict": "supported" },
    { "id": "cjc-1295:claim:physiological-pulsatility", "type": "claim", "label": "More physiological than GH because pulses are preserved", "verdict": "partly supported - mechanism yes, benefit unproven" },
    { "id": "cjc-1295:claim:body-composition", "type": "claim", "label": "Builds muscle / reduces fat / recomposition", "verdict": "unsupported - no human body-composition data" },
    { "id": "cjc-1295:claim:recovery-sleep-healing", "type": "claim", "label": "Improves sleep, recovery, injury healing, skin", "verdict": "unsupported - never measured" },
    { "id": "cjc-1295:claim:anti-aging", "type": "claim", "label": "Anti-ageing", "verdict": "unsupported" },
    { "id": "cjc-1295:claim:proven-safe", "type": "claim", "label": "Clinically tested and proven safe", "verdict": "misleading - programme halted after a death; FDA documented serious AEs" },
    { "id": "cjc-1295:claim:fda-reviewed-ok", "type": "claim", "label": "FDA-reviewed / compliant compounded peptide", "verdict": "misleading - FDA proposed against 503A listing" },
    { "id": "cjc-1295:claim:dac-same-as-modgrf", "type": "claim", "label": "CJC-1295 and Mod GRF (1-29) are the same thing", "verdict": "false" },
    { "id": "cjc-1295:claim:ipamorelin-synergy", "type": "claim", "label": "Stacks synergistically with ipamorelin", "verdict": "hypothesis only - combination never tested in humans" },
    { "id": "cjc-1295:claim:undetectable-for-athletes", "type": "claim", "label": "Safe for athletes / undetectable", "verdict": "false - named in WADA S2" },

    { "id": "src:16352683", "type": "source", "label": "Teichman 2006, J Clin Endocrinol Metab 91(3):799-805", "pmid": "16352683", "doi": "10.1210/jc.2005-1536", "url": "https://pubmed.ncbi.nlm.nih.gov/16352683/" },
