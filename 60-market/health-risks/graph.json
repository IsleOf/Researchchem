    { "id": "event:mmwr-medetomidine-withdrawal-philadelphia-2025", "type": "event", "date": "2025-05-01", "what": "MMWR 74(15):266-268: 165 patients hospitalised with fentanyl withdrawal plus profound autonomic dysfunction; PRES and NSTEMI reported; responded to dexmedetomidine; CDC erratum published", "level": 3 },
    { "id": "event:mmwr-medetomidine-pittsburgh-2025", "type": "event", "date": "2025-05-01", "what": "MMWR 74(15):269-271: 23 adult patients with analogous severe withdrawal, Pittsburgh Oct 2024 - Mar 2025", "level": 3 },
    { "id": "event:prac-naion-conclusion-2025", "type": "event", "date": "2025-06", "what": "EMA PRAC concluded NAION is a very rare side effect of semaglutide (up to 1 in 10,000; ~2-fold risk in T2D); label updates recommended; Novo Nordisk publicly disputed causality", "level": 3 },
    { "id": "event:preprint-peptide-purity-2026", "type": "event", "date": "2026-04", "what": "Preprint on grey-market peptide quality: 41.6-71.1% failed basic quality criteria, ~15% had measurable endotoxin, purity uncorrelated with endotoxin (not peer-reviewed)", "level": 3 },
    { "id": "event:pcac-peptide-votes-2026", "type": "event", "date": "2026-07-23", "what": "FDA Pharmacy Compounding Advisory Committee recommended six of seven peptides (BPC-157, KPV, TB-500, MOTS-c, Semax, Epitalon) for the 503A bulks list, narrowly and against FDA staff advice; non-binding, rulemaking not started", "level": 3 },
    { "id": "event:fda-peptide-warning-letters-2026", "type": "event", "date": "2026-08-24", "what": "FDA CDER warning letters to online peptide sellers; 'research use only' disclaimers held not to protect sellers whose sites carried dosing instructions, injection instructions and dose calculators", "level": 3 },
    { "id": "event:tga-peptide-advisory-2026", "type": "event", "date": "2026", "what": "TGA safety advisory on unapproved peptide products; reports of severe allergic reactions, SIRS and generalised hypersensitivity, plus a liver-injury signal; a product sold as retatrutide contained undeclared semaglutide and no retatrutide (exact advisory date unconfirmed)", "level": 3 },

