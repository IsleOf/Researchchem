    { "id": "event:jama-naion-2024", "type": "event", "date": "2024-07", "what": "JAMA Ophthalmology: 17 of 194 patients with diabetes on semaglutide developed NAION within 36 months (8.9% vs 1.8%); single-centre neuro-ophthalmology referral population", "level": 3 },
